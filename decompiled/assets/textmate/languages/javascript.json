{
  "information_for_contributors": "BoxProxy's own JavaScript grammar (scopeName: source.js). The upstream vscode JavaScript.tmLanguage.json is about 227 KB and is not vendored here; this file covers the syntax used by mihomo / sing-box override scripts. Keep every look-behind assertion fixed-width: the editor's TextMate engine (Oniguruma) rejects variable-width look-behinds, and a single invalid pattern makes the whole grammar fail to load.",
  "name": "JavaScript",
  "scopeName": "source.js",
  "patterns": [
    {
      "include": "#root"
    }
  ],
  "repository": {
    "root": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#string" },
        { "include": "#regexp" },
        { "include": "#block" },
        { "include": "#numbers" },
        { "include": "#object-key" },
        { "include": "#keywords" },
        { "include": "#builtins" },
        { "include": "#property-access" },
        { "include": "#function-call" },
        { "include": "#operators" },
        { "include": "#punctuation" }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.js",
          "match": "//.*$"
        },
        {
          "name": "comment.block.js",
          "begin": "/\\*",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.begin.js" }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": { "name": "punctuation.definition.comment.end.js" }
          }
        }
      ]
    },
    "string": {
      "patterns": [
        { "include": "#string-single" },
        { "include": "#string-double" },
        { "include": "#template-literal" }
      ]
    },
    "string-single": {
      "name": "string.quoted.single.js",
      "begin": "'",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.js" }
      },
      "end": "(')|([^\\\\\\n]$)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.string.end.js" }
      },
      "patterns": [
        { "include": "#string-escape" }
      ]
    },
    "string-double": {
      "name": "string.quoted.double.js",
      "begin": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.js" }
      },
      "end": "(\")|([^\\\\\\n]$)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.string.end.js" }
      },
      "patterns": [
        { "include": "#string-escape" }
      ]
    },
    "string-escape": {
      "name": "constant.character.escape.js",
      "match": "\\\\(x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|u\\{[0-9A-Fa-f]+\\}|[0-7]{1,3}|.)"
    },
    "template-literal": {
      "name": "string.template.js",
      "begin": "`",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.template.begin.js" }
      },
      "end": "`",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.template.end.js" }
      },
      "patterns": [
        { "include": "#template-substitution" },
        { "include": "#string-escape" }
      ]
    },
    "template-substitution": {
      "name": "meta.template.expression.js",
      "begin": "\\$\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.template-expression.begin.js" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.definition.template-expression.end.js" }
      },
      "patterns": [
        { "include": "#root" }
      ]
    },
    "regexp": {
      "name": "string.regexp.js",
      "begin": "(?<=[=(,:!&|?{};\\[\\n])\\s*(/)(?![/*])",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.string.begin.js" }
      },
      "end": "(/)([dgimsuvy]*)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.string.end.js" },
        "2": { "name": "keyword.other.js" }
      },
      "patterns": [
        { "include": "#regexp-content" }
      ]
    },
    "regexp-content": {
      "patterns": [
        {
          "name": "constant.other.character-class.set.regexp",
          "begin": "(\\[)(\\^)?",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.character-class.regexp" },
            "2": { "name": "keyword.operator.negation.regexp" }
          },
          "end": "(\\])",
          "endCaptures": {
            "1": { "name": "punctuation.definition.character-class.regexp" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.js",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "constant.character.escape.js",
          "match": "\\\\."
        },
        {
          "name": "keyword.operator.quantifier.regexp",
          "match": "[*+?]|\\{\\d+(,\\d*)?\\}"
        }
      ]
    },
    "block": {
      "begin": "(\\{)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.block.js" }
      },
      "end": "(\\})",
      "endCaptures": {
        "1": { "name": "punctuation.definition.block.js" }
      },
      "patterns": [
        { "include": "#root" }
      ]
    },
    "numbers": {
      "name": "constant.numeric.js",
      "match": "(?<![\\w$.])(?:0[xX][0-9a-fA-F_]+n?|0[oO][0-7_]+n?|0[bB][01_]+n?|(?:\\d[\\d_]*(?:\\.[\\d_]*)?|\\.\\d[\\d_]*)(?:[eE][+-]?\\d+)?n?)"
    },
    "object-key": {
      "name": "support.type.property-name.js",
      "match": "[A-Za-z_$][\\w$]*(?=\\s*:)"
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.js",
          "match": "(?<![\\w$])(?:if|else|for|while|do|switch|case|default|break|continue|return|try|catch|finally|throw|with|debugger)(?![\\w$])"
        },
        {
          "name": "storage.type.js",
          "match": "(?<![\\w$])(?:var|let|const|function|class|extends|new|delete|typeof|instanceof|in|of|void|yield|async|await|import|export|from|as|get|set|static|super)(?![\\w$])"
        },
        {
          "name": "constant.language.js",
          "match": "(?<![\\w$])(?:this|null|true|false|undefined|NaN|Infinity)(?![\\w$])"
        }
      ]
    },
    "builtins": {
      "name": "support.class.js",
      "match": "(?<![\\w$])(?:console|Math|JSON|Object|Array|Promise|String|Number|Boolean|Symbol|BigInt|Date|RegExp|Error|TypeError|RangeError|SyntaxError|Map|Set|WeakMap|WeakSet|Function|Reflect|Proxy|Intl|globalThis)(?![\\w$])"
    },
    "property-access": {
      "match": "(?:(\\?)\\.|(\\.))\\s*([A-Za-z_$][\\w$]*)",
      "captures": {
        "1": { "name": "punctuation.accessor.optional.js" },
        "2": { "name": "punctuation.accessor.js" },
        "3": { "name": "variable.other.property.js" }
      }
    },
    "function-call": {
      "name": "entity.name.function.js",
      "match": "[A-Za-z_$][\\w$]*(?=\\s*\\()"
    },
    "operators": {
      "name": "keyword.operator.js",
      "match": "(?:===|!==|==|!=|<=|>=|&&|\\|\\||\\?\\?|\\+\\+|--|=>|\\+=|-=|\\*=|/=|%=|\\*\\*=|\\*\\*|<<=|>>=|>>>=|<<|>>|&=|\\|=|\\^=|\\.\\.\\.|[+\\-*/%<>=!&|^~?])"
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.terminator.statement.js", "match": ";" },
        { "name": "punctuation.separator.comma.js", "match": "," },
        { "name": "punctuation.separator.key-value.js", "match": ":" },
        { "name": "punctuation.section.group.js", "match": "[()]" },
        { "name": "punctuation.definition.array.js", "match": "[\\[\\]]" }
      ]
    }
  }
}
