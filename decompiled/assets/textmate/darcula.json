{
  "name": "Box Code Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#1E2127",
    "editor.foreground": "#D7DAE0",
    "editor.lineHighlightBackground": "#2C313A",
    "editor.selectionBackground": "#3E4451",
    "editorCursor.foreground": "#61AFEF"
  },
  "tokenColors": [
    {
      "settings": { "foreground": "#D7DAE0" }
    },
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#7F848E", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string.quoted", "string.unquoted", "string.other.path"],
      "settings": { "foreground": "#98C379" }
    },
    {
      "scope": [
        "support.type.property-name",
        "variable.other.property",
        "entity.name.tag",
        "entity.name.tag.yaml"
      ],
      "settings": { "foreground": "#61AFEF" }
    },
    {
      "scope": [
        "constant.language",
        "constant.language.boolean.true",
        "constant.language.boolean.false",
        "constant.language.null",
        "keyword",
        "storage",
        "meta.directive"
      ],
      "settings": { "foreground": "#C678DD" }
    },
    {
      "scope": ["constant.numeric", "constant.other.ip-address"],
      "settings": { "foreground": "#D19A66" }
    },
    {
      "scope": [
        "punctuation",
        "meta.structure",
        "punctuation.definition.list.begin",
        "punctuation.definition.block.sequence.item.yaml"
      ],
      "settings": { "foreground": "#ABB2BF" }
    },
    {
      "scope": ["entity.name.section", "storage.type.tag-handle.yaml"],
      "settings": { "foreground": "#E5C07B", "fontStyle": "bold" }
    },
    {
      "scope": [
        "variable.other.anchor",
        "variable.other.alias",
        "keyword.control.flow.alias.yaml",
        "keyword.control.property.anchor.yaml",
        "entity.name.type.anchor.yaml",
        "keyword.control.flow.block-scalar.literal.yaml",
        "keyword.control.flow.block-scalar.folded.yaml"
      ],
      "settings": { "foreground": "#E5C07B" }
    },
    {
      "scope": ["entity.name.function", "support.function", "support.class", "entity.name.type.class"],
      "settings": { "foreground": "#61AFEF" }
    },
    {
      "scope": ["variable.parameter", "variable.other.substitution"],
      "settings": { "foreground": "#E06C75" }
    },
    {
      "scope": ["string.other.url", "markup.underline.link"],
      "settings": { "foreground": "#61AFEF", "fontStyle": "underline" }
    },
    {
      "scope": "constant.character.escape",
      "settings": { "foreground": "#E5C07B" }
    },
    {
      "scope": "invalid.illegal",
      "settings": { "foreground": "#F85149", "fontStyle": "bold" }
    },
    {
      "scope": ["entity.other.document.begin.yaml", "entity.other.document.end.yaml"],
      "settings": { "foreground": "#7F848E", "fontStyle": "bold" }
    }
  ]
}
