{
  "name": "Box Code Light",
  "type": "light",
  "colors": {
    "editor.background": "#FFFFFF",
    "editor.foreground": "#1F2328",
    "editor.lineHighlightBackground": "#F6F8FA",
    "editor.selectionBackground": "#B6D7FF",
    "editorCursor.foreground": "#0969DA"
  },
  "tokenColors": [
    {
      "settings": { "foreground": "#1F2328" }
    },
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#6E7781", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string.quoted", "string.unquoted", "string.other.path"],
      "settings": { "foreground": "#0A3069" }
    },
    {
      "scope": [
        "support.type.property-name",
        "variable.other.property",
        "entity.name.tag",
        "entity.name.tag.yaml"
      ],
      "settings": { "foreground": "#0969DA" }
    },
    {
      "scope": [
        "constant.language",
        "constant.language.boolean.true",
        "constant.language.boolean.false",
        "constant.language.null",
        "keyword",
        "storage",
        "meta.directive"
      ],
      "settings": { "foreground": "#8250DF" }
    },
    {
      "scope": ["constant.numeric", "constant.other.ip-address"],
      "settings": { "foreground": "#953800" }
    },
    {
      "scope": [
        "punctuation",
        "meta.structure",
        "punctuation.definition.list.begin",
        "punctuation.definition.block.sequence.item.yaml"
      ],
      "settings": { "foreground": "#57606A" }
    },
    {
      "scope": ["entity.name.section", "storage.type.tag-handle.yaml"],
      "settings": { "foreground": "#953800", "fontStyle": "bold" }
    },
    {
      "scope": [
        "variable.other.anchor",
        "variable.other.alias",
        "keyword.control.flow.alias.yaml",
        "keyword.control.property.anchor.yaml",
        "entity.name.type.anchor.yaml",
        "keyword.control.flow.block-scalar.literal.yaml",
        "keyword.control.flow.block-scalar.folded.yaml"
      ],
      "settings": { "foreground": "#8250DF" }
    },
    {
      "scope": ["entity.name.function", "support.function", "support.class", "entity.name.type.class"],
      "settings": { "foreground": "#0969DA" }
    },
    {
      "scope": ["variable.parameter", "variable.other.substitution"],
      "settings": { "foreground": "#953800" }
    },
    {
      "scope": ["string.other.url", "markup.underline.link"],
      "settings": { "foreground": "#0969DA", "fontStyle": "underline" }
    },
    {
      "scope": "constant.character.escape",
      "settings": { "foreground": "#CF222E" }
    },
    {
      "scope": "invalid.illegal",
      "settings": { "foreground": "#CF222E", "fontStyle": "bold" }
    },
    {
      "scope": ["entity.other.document.begin.yaml", "entity.other.document.end.yaml"],
      "settings": { "foreground": "#6E7781", "fontStyle": "bold" }
    }
  ]
}
