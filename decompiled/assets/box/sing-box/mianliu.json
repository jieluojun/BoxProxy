      "path": "./proxies/CNS订阅.json",
      "update_interval": "3h",
      "health_check": {
        "enabled": true,
        "interval": "1m0s",
        "timeout": "5s"
      },
      "override_transport": {
        "host": "m.youku.com"
      }
    },
    {
      "type": "remote",
      "tag": "百度直连",
      "url": "https://gist.githubusercontent.com/jieluojun/d4b528ee3418740112357a80e940d912/raw/BaiduDirect",
      "path": "./proxies/百度直连.json",
      "user_agent": "sing-box",
      "update_interval": "3h",
      "health_check": {
        "enabled": true,
        "interval": "1m0s",
        "timeout": "5s"
      }
    },
    {
      "type": "remote",
      "tag": "钉钉直连",
