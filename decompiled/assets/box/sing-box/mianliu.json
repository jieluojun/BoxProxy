        "update_interval": "24h"
      }
    ],
    "final": "国外出口",
    "find_process": true,
    "auto_detect_interface": true,
    "default_domain_resolver": "腾讯DNS",
    "default_http_client": "远程下载"
  },
  "services": [
    {
      "type": "api",
      "tag": "sing-box-api",
      "listen": "0.0.0.0",
      "listen_port": 9999,
      "dashboard": {
        "enabled": true,
        "path": "sing-box-dashboard",
        "download_url": "https://v6.gh-proxy.org/https://github.com/SagerNet/sing-box-dashboard/archive/refs/heads/gh-pages.zip",
        "http_client": "远程下载"
      }
    }
  ],
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "cache.db",
      "store_fakeip": true,
      "store_dns": true
    },
    "clash_api": {
      "external_controller": "0.0.0.0:9090",
      "external_ui": "ui",
      "external_ui_download_url": "https://v6.gh-proxy.org/https://github.com/Zephyruso/zashboard/archive/refs/heads/gh-pages-no-fonts.zip",
      "external_ui_http_client": "远程下载",
      "default_mode": "规则"
    },
    "urltest_unified_delay": true
  },
  "http_clients": [
    {
      "tag": "远程下载",
      "version": 2,
      "detour": "订阅更新",
      "stream_receive_window": 0,
      "connection_receive_window": 0
    }
  ]
