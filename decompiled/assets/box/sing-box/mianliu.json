        "rule_set": "本地地址",
        "outbound": "直连出口"
      },
      {
        "clash_mode": "规则",
        "rule_set": "大陆地址",
        "outbound": "国内出口"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "排除域名",
        "path": "./rules/排除域名.srs",
        "url": "https://v6.gh-proxy.org/https://github.com/DustinWin/ruleset_geodata/releases/download/sing-box-ruleset/fakeip-filter.srs",
        "update_interval": "24h"
      },
      {
        "type": "remote",
        "tag": "广告域名",
        "path": "./rules/广告域名.srs",
        "url": "https://v6.gh-proxy.org/https://github.com/DustinWin/ruleset_geodata/releases/download/sing-box-ruleset/ads.srs",
        "update_interval": "24h"
      },
      {
        "type": "remote",
        "tag": "海外域名",
        "path": "./rules/海外域名.srs",
        "url": "https://v6.gh-proxy.org/https://github.com/DustinWin/ruleset_geodata/releases/download/sing-box-ruleset/proxy.srs",
        "update_interval": "24h"
      },
      {
        "type": "remote",
        "tag": "大陆域名",
        "path": "./rules/大陆域名.srs",
        "url": "https://v6.gh-proxy.org/https://github.com/DustinWin/ruleset_geodata/releases/download/sing-box-ruleset/cn.srs",
        "update_interval": "24h"
      },
      {
        "type": "remote",
        "tag": "本地地址",
        "path": "./rules/本地地址.srs",
        "url": "https://v6.gh-proxy.org/https://github.com/DustinWin/ruleset_geodata/releases/download/sing-box-ruleset/private.srs",
        "update_interval": "24h"
      },
      {
        "type": "remote",
