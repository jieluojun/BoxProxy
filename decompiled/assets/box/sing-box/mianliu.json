  "providers": [
    /*
    {
      "type": "local",
      "tag": "非免节点",
      "path": "./proxies/非免节点.txt",
      "health_check": {
        "enabled": true,
        "interval": "1m0s",
        "timeout": "5s"
      },
      "override_dialer": {
        "detour": "链式代理"
      }
