  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 53
          },
          {
            "protocol": "dns"
          }
        ],
        "action": "hijack-dns"
      },
      {
        "clash_mode": "全局",
        "outbound": "国外出口"
      },
      {
        "clash_mode": "直连",
        "outbound": "直连出口"
      },
      {
        "rule_set": "广告域名",
        "outbound": "广告出口"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "network": "udp",
            "port": [
              443,
              3478,
              5349
            ]
          },
          {
            "network": "udp",
