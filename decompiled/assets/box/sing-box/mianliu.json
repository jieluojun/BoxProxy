      "path": "./proxies/钉钉直连.json",
      "user_agent": "sing-box",
      "update_interval": "3h",
      "health_check": {
        "enabled": true,
        "interval": "1m0s",
        "timeout": "5s"
      },
      "override_transport": {
        "path": "@gw.alicdn.com"
      }
    }
  ],
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "谷歌DNS",
        "detour": "国外出口",
        "server": "8.8.8.8"
      },
      {
        "type": "https",
        "tag": "CF-DNS",
        "detour": "国外出口",
        "server": "1.1.1.1"
      },
      {
        "type": "https",
        "tag": "腾讯DNS",
        "detour": "DNS出口",
        "server": "1.12.12.12"
      },
      {
        "type": "https",
        "tag": "阿里DNS",
        "server": "223.5.5.5"
      },
      {
        "type": "fakeip",
        "tag": "虚拟DNS",
        "inet4_range": "198.18.0.1/16",
        "inet6_range": "fc00::/18"
      }
    ],
    "rules": [
      {
        "clash_mode": "全局",
        "server": "CF-DNS"
      },
      {
        "clash_mode": "直连",
        "server": "阿里DNS"
      },
      {
        "domain_regex": "(^|\\.)(alt[1-8]-mtalk|mtalk|mtalk4)\\.google\\.com$",
        "server": "腾讯DNS"
      },
      {
        "rule_set": "海外域名",
        "server": "谷歌DNS"
      },
      {
        "clash_mode": "规则",
        "rule_set": "大陆域名",
        "server": "腾讯DNS"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "虚拟DNS",
        "rewrite_ttl": 1
      }
    ],
    "final": "谷歌DNS",
    "strategy": "prefer_ipv4",
    "cache_capacity": 4096,
    "optimistic": true
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "::",
      "listen_port": 7890
