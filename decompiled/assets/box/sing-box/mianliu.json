      },
      {
        "domain_regex": "(^|\\.)(alt[1-8]-mtalk|mtalk|mtalk4)\\.google\\.com$",
        "outbound": "国内出口"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "rule_set": "海外域名"
          },
          {
            "domain_suffix": [
              "right.com.cn",
              "sgameglobal.com"
            ]
          },
          {
            "port": 446
          }
        ],
        "outbound": "国外出口"
      },
      {
        "domain_suffix": [
          "xajtl.com",
          "dlproxy.uk",
          "steamcontent.com",
          "xn--qfsx5xvnik06b.com"
        ],
        "clash_mode": "规则",
        "outbound": "国内出口"
      },
      {
        "clash_mode": "规则",
        "rule_set": "大陆域名",
