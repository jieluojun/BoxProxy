    */
    {
      "type": "remote",
      "tag": "免流订阅",
      "url": "https://gist.githubusercontent.com/jieluojun/d4b528ee3418740112357a80e940d912/raw/MLSub",
      "path": "./proxies/免流订阅.json",
      "update_interval": "3h",
      "health_check": {
        "enabled": true,
        "interval": "1m0s",
        "timeout": "5s"
      },
      "override_transport": {
        "host": "m.youku.com"
      }
    },
    {
      "type": "remote",
