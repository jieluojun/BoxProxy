+            "vpn tun fd {} is not available ({}): {err}",
+            fd,
+            path.display()
+        )
+    })?;
+    let duplicated = unsafe { libc::dup(opened.as_raw_fd()) };
+    drop(opened);
+    if duplicated < 0 {
+        return Err(format!("dup vpn tun fd {fd} failed"));
+    }
+    if !is_tun_fd(duplicated) {
+        unsafe { libc::close(duplicated) };
+        return Err(format!("vpn fd {fd} is not a TUN device"));
+    }
+    Ok(duplicated)
+}
+
+fn is_tun_fd(fd: i32) -> bool {
+    fs::read_link(format!("/proc/self/fd/{fd}"))
+        .ok()
+        .and_then(|path| path.to_str().map(|value| value.to_string()))
+        .map(|path| path.starts_with("/dev/net/tun"))
+        .unwrap_or(false)
+}
