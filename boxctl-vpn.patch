+        std::thread::Builder::new()
+            .name("boxctl-child-reaper".to_string())
+            .stack_size(CHILD_REAPER_STACK_SIZE)
+            .spawn(move || {
+                let _ = child.wait();
+            })
+            .map_err(|err| format!("start child reaper thread failed: {err}"))?;
+
+        Ok(Some(pid))
+    }
