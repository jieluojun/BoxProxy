{
  "schemaVersion": 1,
  "features": [
    {"id": "config-history", "title": "每内核配置历史与默认配置恢复", "patterns": ["CoreConfigHistory", "RestoreCfg", "proxy_config_restore"]},
    {"id": "root-runtime", "title": "root 路径、动态库与实时版本查询", "patterns": ["LdFix", "BoxctlFix", "VpnRoot", "bpld", "core_version", "ipv6_.*\\.sh"]},
    {"id": "editor-forms", "title": "编辑器、可视化、锚点与 schema", "patterns": ["com/box/app/cfg/", "top/yukonga/", "CfgGlue", "CfgNav", "CfgDefer", "cfgD", "assets/schema/", "FormActivity", "AnchorActivity"]},
    {"id": "core-downloads", "title": "内核 fork 菜单、下载和识别", "patterns": ["sing-box_ref1nd", "sing-box_dingtalk", "mihomo_dingtalk", "proxy_core_", "tools_update_core"]},
    {"id": "vpn-runtime", "title": "VPN、非 root 引导、权限与服务", "patterns": ["com/box/app/vpn/", "VpnBridge", "VpnPrefs", "VpnSeed", "VpnPrepare", "BoxVpnService", "BootReceiver", "AppPerm", "BIND_VPN_SERVICE", "BOOT_COMPLETED", "GET_INSTALLED_APPS", "assets/vpn/", "proxy_mode_vpn"]},
    {"id": "preferences-ui", "title": "设置、过滤提示、电池与自启入口", "patterns": ["FToast", "BattToggle", "service_battery_", "service_auto_start", "BATTERY_OPTIMIZATIONS", "use_net_speed_clash_api"]},
    {"id": "bundled-configs", "title": "内置配置与辅助资源", "patterns": ["assets/box/"]},
    {"id": "shared-runtime", "title": "共享依赖与其余接入点", "patterns": [".*"]}
  ],
  "policy": "All features are required; classification is organizational, never evidence of compatibility or permission to publish a partial migration."
}
